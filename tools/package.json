{
  "name": "kordex-repository-checks",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "check": "tsc --noEmit && node --test test/*.test.ts && node check-repository.ts",
    "check:leaves": "node check-repository.ts",
    "generate": "node check-repository.ts --write",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sync:skills": "node sync-skills.ts --write"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.2",
    "yaml": "2.8.1",
    "zod": "4.3.6"
  }
}
